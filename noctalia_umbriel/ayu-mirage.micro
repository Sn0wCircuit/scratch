# Ayu mirage for micro - palette from the official `ayu` package (ayu-theme/ayu-colors)
# Requires true color: COLORTERM=truecolor (or `set truecolor on`)

color-link default "#cccac2,#242936"
color-link comment "italic #6e7c8f"
color-link identifier "#cccac2"
color-link constant "#dfbfff"
color-link constant.string "#d5ff80"
color-link constant.specialChar "#95e6cb"
color-link constant.number "#dfbfff"
color-link constant.bool "#dfbfff"
color-link statement "#ffa659"
color-link symbol "#f29e74"
color-link symbol.brackets "#cccac2"
color-link symbol.tag "#5ccfe6"
color-link preproc "#d9be98"
color-link type "#73d0ff"
color-link type.keyword "#ffa659"
color-link special "#d9be98"
color-link underlined "underline #73d0ff"
color-link error "#ff6666"
color-link todo "bold #ffcc66"
color-link ignore "#707a8c"
color-link selection ",#2b4768"
color-link hlsearch "#cccac2,#736950"
color-link match-brace "bold #ffcc66,#2b4768"
color-link cursor-line "#1a1f29"
color-link color-column ",#282e3b"
color-link indent-char "#363c4a"
color-link line-number "#4a5261"
color-link current-line-number "#707a8c"
color-link gutter-error "#ff6666"
color-link gutter-warning "#ffcd66"
color-link gutter-info "#73d0ff"
color-link diff-added "#87d96c"
color-link diff-modified "#80bfff"
color-link diff-deleted "#f27983"
color-link statusline "#707a8c,#1f2430"
color-link statusline.inactive "#707a8c,#1f2430"
color-link statusline.suggestions "#cccac2,#282e3b"
color-link tabbar "#707a8c,#1f2430"
color-link tabbar.active "bold #ffcc66,#242936"
color-link divider "#171b24,#242936"
color-link scrollbar "#4a5261"
color-link message "#cccac2,#282e3b"
color-link error-message "#ff6666,#282e3b"
color-link tab-error ",#ff6666"
color-link trailingws ",#ff6666"
