# Ayu light for micro - palette from the official `ayu` package (ayu-theme/ayu-colors)
# Requires true color: COLORTERM=truecolor (or `set truecolor on`)

color-link default "#5c6166,#fcfcfc"
color-link comment "italic #adaeb1"
color-link identifier "#5c6166"
color-link constant "#a37acc"
color-link constant.string "#86b300"
color-link constant.specialChar "#4cbf99"
color-link constant.number "#a37acc"
color-link constant.bool "#a37acc"
color-link statement "#fa8532"
color-link symbol "#f2a191"
color-link symbol.brackets "#5c6166"
color-link symbol.tag "#55b4d4"
color-link preproc "#e59645"
color-link type "#22a4e6"
color-link type.keyword "#fa8532"
color-link special "#e59645"
color-link underlined "underline #22a4e6"
color-link error "#e65050"
color-link todo "bold #f29718"
color-link ignore "#828e9f"
color-link selection ",#d7e4f6"
color-link hlsearch "#5c6166,#ffe294"
color-link match-brace "bold #f29718,#d7e4f6"
color-link cursor-line ",#f0f1f3"
color-link color-column ",#fafafa"
color-link indent-char "#e6e8eb"
color-link line-number "#cbd0d7"
color-link current-line-number "#9aa4b2"
color-link gutter-error "#e65050"
color-link gutter-warning "#eba400"
color-link gutter-info "#22a4e6"
color-link diff-added "#6cbf43"
color-link diff-modified "#478acc"
color-link diff-deleted "#ff7383"
color-link statusline "#828e9f,#f8f9fa"
color-link statusline.inactive "#828e9f,#f8f9fa"
color-link statusline.suggestions "#5c6166,#fafafa"
color-link tabbar "#828e9f,#f8f9fa"
color-link tabbar.active "bold #f29718,#fcfcfc"
color-link divider "#eaedef,#fcfcfc"
color-link scrollbar "#cbd0d7"
color-link message "#5c6166,#fafafa"
color-link error-message "#e65050,#fafafa"
color-link tab-error ",#e65050"
color-link trailingws ",#e65050"
