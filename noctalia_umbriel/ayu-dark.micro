# Ayu dark for micro - palette from the official `ayu` package (ayu-theme/ayu-colors)
# Requires true color: COLORTERM=truecolor (or `set truecolor on`)

color-link default "#bfbdb6,#10141c"
color-link comment "italic #5a6673"
color-link identifier "#bfbdb6"
color-link constant "#d2a6ff"
color-link constant.string "#aad94c"
color-link constant.specialChar "#95e6cb"
color-link constant.number "#d2a6ff"
color-link constant.bool "#d2a6ff"
color-link statement "#ff8f40"
color-link symbol "#f29668"
color-link symbol.brackets "#bfbdb6"
color-link symbol.tag "#39bae6"
color-link preproc "#e6c08a"
color-link type "#59c2ff"
color-link type.keyword "#ff8f40"
color-link special "#e6c08a"
color-link underlined "underline #59c2ff"
color-link error "#d95757"
color-link todo "bold #e6b450"
color-link ignore "#5a6378"
color-link selection ",#193155"
color-link hlsearch "#bfbdb6,#4c4126"
color-link match-brace "bold #e6b450,#193155"
color-link cursor-line ",#161a24"
color-link color-column ",#141821"
color-link indent-char "#232834"
color-link line-number "#404758"
color-link current-line-number "#5a6378"
color-link gutter-error "#d95757"
color-link gutter-warning "#ffb454"
color-link gutter-info "#59c2ff"
color-link diff-added "#70bf56"
color-link diff-modified "#73b8ff"
color-link diff-deleted "#f26d78"
color-link statusline "#5a6378,#0d1017"
color-link statusline.inactive "#5a6378,#0d1017"
color-link statusline.suggestions "#bfbdb6,#141821"
color-link tabbar "#5a6378,#0d1017"
color-link tabbar.active "bold #e6b450,#10141c"
color-link divider "#1b1f29,#10141c"
color-link scrollbar "#404758"
color-link message "#bfbdb6,#141821"
color-link error-message "#d95757,#141821"
color-link tab-error ",#d95757"
color-link trailingws ",#d95757"
