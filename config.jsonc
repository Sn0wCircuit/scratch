{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "padding": {
            "top": 2
        },
        "color": {
            "1": "#39BAE6"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#FFB454"
        }
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│  user    │",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ 󰇅 hname   │",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ 󰔟 os age  │",
            "type": "command",
            "text": "d=$(( ($(date +%s) - $(stat -c %W /)) / 86400 )); if [ $d -ge 365 ]; then echo \"$((d/365))y $(((d%365)/30))m\"; elif [ $d -ge 30 ]; then echo \"$((d/30))m $((d%30))d\"; else echo \"${d}d\"; fi"
        },
        {
            "key": "│ {icon} distro  │",
            "type": "os"
        },
        {
            "key": "│  kernel  │",
            "type": "kernel"
        },
        {
            "key": "│ 󰇄 desktop │",
            "type": "de"
        },
        {
            "key": "│  term    │",
            "type": "terminal"
        },
        {
            "key": "│  shell   │",
            "type": "shell"
        },
        {
            "key": "│ 󰍛 cpu     │",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ 󰉉 disk    │",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ 󰘚 memory  │",
            "type": "memory"
        },
        {
            "key": "│ 󰏖 pkgs    │",
            "type": "packages"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│  colors  │",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
