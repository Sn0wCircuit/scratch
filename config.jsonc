{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 2
    },
    "color": {
      "1": "blue"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "󰀄 user    ",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "󰇅 hname   ",
      "format": "{host-name}"
    },
    {
      "type": "command",
      "key": "󰔟 os age  ",
      "text": "d=$(( ($(date +%s) - $(stat -c %W /)) / 86400 )); if [ $d -ge 365 ]; then n=$((d/365)); u=year; elif [ $d -ge 30 ]; then n=$((d/30)); u=month; else n=$d; u=day; fi; [ $n -eq 1 ] || u=${u}s; echo $n $u"
    },
    {
      "type": "os",
      "key": "󰣇 distro  "
    },
    {
      "type": "kernel",
      "key": "󰌽 kernel  "
    },
    {
      "type": "de",
      "key": "󰇄 desktop "
    },
    {
      "type": "terminal",
      "key": "󰆍 term    "
    },
    {
      "type": "shell",
      "key": "󰞷 shell   "
    },
    {
      "type": "cpu",
      "key": "󰻠 cpu     "
    },
    {
      "type": "gpu",
      "key": "󰢮 gpu     ",
      "hideType": "integrated",
      "format": "{vendor} {name}"
    },
    {
      "type": "disk",
      "key": "󰉉 disk    ",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "󰍛 memory  "
    },
    {
      "type": "swap",
      "key": "󰓡 swap    "
    },
    {
      "type": "packages",
      "key": "󰏖 pkgs    "
    }
  ]
}
